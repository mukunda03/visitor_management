# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Environment config (contains API keys / secrets)
# Keep config/example.json committed as a template.
/config/*.json
!/config/example.json
.env
.env.*
!.env.example
*.env

# Firebase / Google services config
google-services.json
GoogleService-Info.plist
.firebaserc
firebase-debug.log

# Android signing (never commit keystores)
key.properties
*.keystore
*.jks

# FVM (Flutter Version Management) local SDK link
.fvm/flutter_sdk
